{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": {
      "*": "allow"
    }
  },
  "agent": {
    "ugly": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "pytest *": "allow",
          ".venv/bin/pytest *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          ".venv/bin/python *": "allow",
          ".venv/bin/python3 *": "allow",
          "ruff *": "allow",
          ".venv/bin/ruff *": "allow",
          "mypy *": "allow",
          ".venv/bin/mypy *": "allow",
          "*manage.py check*": "allow",
          "*manage.py makemigrations --check*": "allow",
          "*manage.py shell -c*": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "which *": "allow",
          "echo *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "tree *": "allow",
          "sed -n *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse *": "allow",
          "git branch": "allow",
          "openspec *": "allow",
          "rm *": "deny",
          "rmdir *": "deny",
          "mv *": "deny",
          "cp *": "deny",
          "chmod *": "deny",
          "chown *": "deny",
          "sed -i*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git checkout*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "manage.py migrate*": "deny",
          "*manage.py migrate*": "deny"
        }
      }
    },
    "bad": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "pytest *": "allow",
          ".venv/bin/pytest *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          ".venv/bin/python *": "allow",
          ".venv/bin/python3 *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "which *": "allow",
          "echo *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "tree *": "allow",
          "sed -n *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse *": "allow",
          "git branch": "allow",
          "rm *": "deny",
          "rmdir *": "deny",
          "mv *": "deny",
          "cp *": "deny",
          "chmod *": "deny",
          "chown *": "deny",
          "sed -i*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git checkout*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "manage.py migrate*": "deny",
          "*manage.py migrate*": "deny"
        }
      }
    }
  }
}
